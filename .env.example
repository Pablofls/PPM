# Copiar a .env.local y llenar con los valores del proyecto de Supabase.
# .env.local está en .gitignore y NUNCA se commitea (regla 2 de CLAUDE.md).
#
# En esta iteración la aplicación corre SIN base de datos: no hace falta crear
# .env.local para levantarla con `npm run dev`.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# La service_role key NO va aquí ni en ningún archivo del repositorio.
# El script de importación la toma de una variable de entorno de la terminal.
